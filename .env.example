# Infinity Bangladesh — Environment Configuration Template
# Team Infinity | United for Humanity
# Note: Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit your actual .env file or production secrets to source control.

# ==========================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
# Example: postgresql://username:password@localhost:5432/infinity_bangladesh?schema=public
# Cloud: Neon, Supabase, AWS RDS, or Vercel Postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/infinity_db?schema=public"

# ==========================================
# 2. APPLICATION & AUTHENTICATION
# ==========================================
NEXT_PUBLIC_SITE_URL="https://infinitybangladesh.org"
NEXTAUTH_URL="https://infinitybangladesh.org"
NEXTAUTH_SECRET="generate_a_secure_random_32_character_hex_secret_here"

# Admin fallback initialization passcode (production requires hashed credentials)
ADMIN_DEFAULT_PASSCODE="infinity2025"

# ==========================================
# 3. PAYMENT GATEWAYS (bKash & Nagad)
# ==========================================
# bKash Merchant Checkout API Credentials
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta" # Use production URL in live

# Nagad PGW Credentials
NAGAD_MERCHANT_ID=""
NAGAD_API_KEY=""
NAGAD_PUBLIC_KEY=""
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"

# General / Online Payment Gateway
PAYMENT_API_KEY=""

# ==========================================
# 4. CLOUD MEDIA & FILE STORAGE
# ==========================================
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3 / Supabase Storage Compatible
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ==========================================
# 5. TRANSACTIONAL EMAIL (Resend / SMTP)
# ==========================================
EMAIL_API_KEY=""
EMAIL_FROM="Infinity Bangladesh Desk <noreply@infinitybangladesh.org>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ==========================================
# 6. ANALYTICS & MONITORING (Optional)
# ==========================================
GOOGLE_ANALYTICS_ID=""
GOOGLE_SEARCH_CONSOLE_VERIFICATION=""
