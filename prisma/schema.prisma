// Prisma Schema for Infinity Bangladesh
// Organization: Infinity Bangladesh (Team Infinity — United for Humanity)
// Database: PostgreSQL with robust indexes, relations, and audit trails

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  AUDITOR
}

enum CampaignStatus {
  ACTIVE
  UPCOMING
  COMPLETED
  ARCHIVED
}

enum VolunteerStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
  CONTACTED
  ARCHIVED
}

enum DonationStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum ReportStatus {
  OFFICIAL
  PENDING_VERIFICATION
  DRAFT
  ARCHIVED
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  role         Role       @default(ADMIN)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@index([email])
}

model Program {
  id                   String     @id @default(cuid())
  slug                 String     @unique
  titleEn              String
  titleBn              String
  category             String
  shortDescriptionEn   String
  shortDescriptionBn   String
  fullDetailsEn        String     @db.Text
  fullDetailsBn        String     @db.Text
  impactHighlightsEn   String[]
  impactHighlightsBn   String[]
  imageUrl             String
  iconName             String     @default("HeartHandshake")
  status               String     @default("active")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  campaigns            Campaign[]

  @@index([slug])
  @@index([category])
}

model Campaign {
  id               String          @id @default(cuid())
  slug             String          @unique
  titleEn          String
  titleBn          String
  date             String
  locationEn       String
  locationBn       String
  category         String
  descriptionEn    String          @db.Text
  descriptionBn    String          @db.Text
  objectivesEn     String[]
  objectivesBn     String[]
  activitiesEn     String[]
  activitiesBn     String[]
  beneficiariesEn  String
  beneficiariesBn  String
  impactEn         String          @db.Text
  impactBn         String          @db.Text
  status           CampaignStatus  @default(ACTIVE)
  isFeatured       Boolean         @default(false)
  targetAmountBDT  String?
  raisedAmountBDT  String?
  imageUrl         String
  videoUrl         String?
  reportUrl        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  programId        String?
  program          Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  galleryImages    CampaignImage[]
  donations        Donation[]
  stories          ImpactStory[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
}

model CampaignImage {
  id         String   @id @default(cuid())
  campaignId String
  imageUrl   String
  captionEn  String?
  captionBn  String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model ImpactStory {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  titleEn              String
  titleBn              String
  personOrCommunityEn  String
  personOrCommunityBn  String
  locationEn           String
  locationBn           String
  date                 String
  storyEn              String    @db.Text
  storyBn              String    @db.Text
  impactEn             String    @db.Text
  impactBn             String    @db.Text
  imageUrl             String
  consentConfirmed     Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  campaignId           String?
  campaign             Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([slug])
}

model Volunteer {
  id                  String          @id @default(cuid())
  fullName            String
  email               String
  phone               String
  district            String
  upazila             String?
  age                 Int?
  occupation          String?
  bloodGroup          String?
  skills              String[]
  areasOfInterest     String[]
  previousExperience  String?         @db.Text
  availability        String?
  message             String?         @db.Text
  consent             Boolean         @default(true)
  agreedCodeOfConduct Boolean         @default(true)
  status              VolunteerStatus @default(NEW)
  adminNotes          String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([district])
  @@index([status])
  @@index([email])
}

model Donation {
  id             String         @id @default(cuid())
  receiptNumber  String         @unique
  donorName      String
  donorEmail     String?
  donorPhone     String?
  amountBDT      Decimal        @db.Decimal(10, 2)
  currency       String         @default("BDT")
  donationType   String         @default("one-time")
  paymentMethod  String
  transactionId  String?
  status         DonationStatus @default(PENDING)
  isAnonymous    Boolean        @default(false)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaignId     String?
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([receiptNumber])
  @@index([status])
  @@index([createdAt])
}

model Event {
  id               String      @id @default(cuid())
  slug             String      @unique
  titleEn          String
  titleBn          String
  date             String
  time             String
  locationEn       String
  locationBn       String
  descriptionEn    String      @db.Text
  descriptionBn    String      @db.Text
  imageUrl         String
  status           EventStatus @default(UPCOMING)
  registrationOpen Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([slug])
  @@index([status])
}

model News {
  id             String     @id @default(cuid())
  slug           String     @unique
  titleEn        String
  titleBn        String
  excerptEn      String     @db.Text
  excerptBn      String     @db.Text
  contentEn      String     @db.Text
  contentBn      String     @db.Text
  category       String
  author         String     @default("Infinity Bangladesh Desk")
  date           String
  imageUrl       String
  tags           String[]
  status         NewsStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])
}

model GalleryImage {
  id           String   @id @default(cuid())
  titleEn      String
  titleBn      String
  captionEn    String?
  captionBn    String?
  imageUrl     String
  category     String
  date         String
  locationEn   String?
  locationBn   String?
  campaignSlug String?
  createdAt    DateTime @default(now())

  @@index([category])
}

model Video {
  id            String   @id @default(cuid())
  titleEn       String
  titleBn       String
  videoUrl      String
  embedUrl      String?
  platform      String   @default("youtube") // youtube, facebook, direct
  duration      String?
  thumbnailUrl  String
  date          String
  descriptionEn String?  @db.Text
  descriptionBn String?  @db.Text
  category      String   @default("General")
  status        String   @default("published")
  isFeatured    Boolean  @default(false)
  sourceType    String   @default("url")
  aspectRatio   String   @default("16/9")
  isShorts      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model TransparencyReport {
  id            String       @id @default(cuid())
  titleEn       String
  titleBn       String
  type          String       // Annual Report, Campaign Report, Financial Audit, Policy, Legal
  year          String
  descriptionEn String       @db.Text
  descriptionBn String       @db.Text
  uploadDate    String
  fileUrl       String
  fileSize      String       @default("[OFFICIAL FILE UPLOAD REQUIRED]")
  status        ReportStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@index([year])
}

model Partner {
  id              String   @id @default(cuid())
  name            String
  logoUrl         String?
  website         String?
  type            String   // Institutional, Academic, Community Alliance, Resource
  descriptionEn   String
  descriptionBn   String
  partnershipYear String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String
  subject     String
  message     String        @db.Text
  status      MessageStatus @default(UNREAD)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ImpactMetric {
  id            String   @id @default(cuid())
  labelEn       String
  labelBn       String
  value         String   // e.g. "[X]+", "100%"
  descriptionEn String
  descriptionBn String
  iconName      String   @default("Users")
  order         Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  id                     String   @id @default("default")
  organizationName       String   @default("Infinity Bangladesh")
  teamIdentity           String   @default("Team Infinity")
  tagline                String   @default("United for Humanity")
  country                String   @default("Bangladesh")
  officialAddress        String   @default("[OFFICIAL ADDRESS REQUIRED]")
  officialPhone          String   @default("[OFFICIAL PHONE REQUIRED]")
  officialEmail          String   @default("contact@infinitybangladesh.org [OFFICIAL EMAIL TO BE VERIFIED]")
  facebookUrl            String   @default("https://www.facebook.com/infinitybangladesh")
  youtubeUrl             String?
  instagramUrl           String?
  linkedinUrl            String?
  bKashNumber            String   @default("[OFFICIAL BKASH MERCHANT/PERSONAL NUMBER REQUIRED]")
  nagadNumber            String   @default("[OFFICIAL NAGAD NUMBER REQUIRED]")
  bankName               String   @default("[OFFICIAL BANK NAME REQUIRED]")
  accountName            String   @default("Infinity Bangladesh / Team Infinity [OFFICIAL TITLE REQUIRED]")
  accountNumber          String   @default("[OFFICIAL ACCOUNT NUMBER REQUIRED]")
  branchName             String   @default("[OFFICIAL BRANCH REQUIRED]")
  routingNumber          String   @default("[OFFICIAL ROUTING NUMBER REQUIRED]")
  bannerAnnouncementEn   String?
  bannerAnnouncementBn   String?
  showAnnouncementBanner Boolean  @default(true)
  registrationNumber     String   @default("[OFFICIAL REGISTRATION NUMBER REQUIRED]")
  updatedAt              DateTime @updatedAt
}

model AuditLog {
  id          String     @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String     // e.g. "CAMPAIGN_CREATED", "VOLUNTEER_APPROVED", "DONATION_VERIFIED"
  entity      String     // "Campaign", "Volunteer", "Donation", "SiteSetting", "Committee"
  entityId    String
  details     String     @db.Text
  createdAt   DateTime   @default(now())

  adminUser   AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

enum CommitteeType {
  EXECUTIVE
  STANDING
  ADVISORY
  PAST
  SPECIAL
}

enum CommitteeStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model Committee {
  id            String            @id @default(cuid())
  nameEn        String
  nameBn        String
  year          String
  type          CommitteeType     @default(EXECUTIVE)
  descriptionEn String?           @db.Text
  descriptionBn String?           @db.Text
  status        CommitteeStatus   @default(ACTIVE)
  isFeatured    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  members       CommitteeMember[]

  @@index([year])
  @@index([type])
  @@index([status])
}

model Person {
  id           String            @id @default(cuid())
  fullName     String
  banglaName   String
  photoUrl     String?
  district     String?
  shortBioEn   String?           @db.Text
  shortBioBn   String?           @db.Text
  phone        String?
  email        String?
  facebookUrl  String?
  linkedinUrl  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  memberships  CommitteeMember[]

  @@index([fullName])
  @@index([banglaName])
}

model Position {
  id           String            @id @default(cuid())
  nameEn       String
  nameBn       String
  level        Int               @default(4) // 1: President, 2: VP, 3: GS, 4: Joint/Dept Sec, 5: Member
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  members      CommitteeMember[]

  @@index([level])
  @@index([sortOrder])
}

model CommitteeMember {
  id               String      @id @default(cuid())
  committeeId      String
  personId         String
  positionId       String
  serialNumber     Int         @default(1)
  sortOrder        Int         @default(0)
  isFeaturedLeader Boolean     @default(false)
  customTitleEn    String?
  customTitleBn    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  committee        Committee   @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  person           Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  position         Position    @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([committeeId])
  @@index([personId])
  @@index([positionId])
  @@index([sortOrder])
  @@index([serialNumber])
}

model VideoItem {
  id           String   @id @default(cuid())
  titleEn      String
  titleBn      String
  videoUrl     String
  embedUrl     String?
  thumbnailUrl String
  platform     String   @default("youtube")
  duration     String?
  date         String
  descriptionEn String  @db.Text
  descriptionBn String  @db.Text
  category     String   @default("General")
  status       String   @default("published")
  isFeatured   Boolean  @default(false)
  sourceType   String?  @default("url")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model JourneyVideo {
  id             String   @id @default(cuid())
  titleEn        String
  titleBn        String
  timelineLabelEn String
  timelineLabelBn String
  descriptionEn  String   @db.Text
  descriptionBn  String   @db.Text
  category       String   @default("Organizational Journey")
  videoUrl       String   @default("")
  videoPlatform  String   @default("auto")
  embedUrl       String?
  thumbnailUrl   String?
  displayOrder   Int      @default(0)
  isPublished    Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([displayOrder])
  @@index([isPublished])
  @@index([isFeatured])
}


